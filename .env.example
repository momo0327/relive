# Copy to .env.local and fill in. EXPO_PUBLIC_* values are embedded in the app
# binary: only put public values here. Never add the Supabase secret/service key.

# Supabase project (Project Settings → API). Leave empty to run in preview mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Links shown in the app (required before App Store submission).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_HELP_URL=

# Optional: https origin with universal links (apple-app-site-association) for
# invite links, e.g. https://l8r.app. Without it, invites use the l8r:// scheme.
EXPO_PUBLIC_INVITE_BASE_URL=

# Set to "off" to hide Google sign-in until the provider is configured.
# Set to "on" to show "Sign in with email" (pre-created accounts only, e.g. App Review).
EXPO_PUBLIC_EMAIL_SIGN_IN=
EXPO_PUBLIC_GOOGLE_SIGN_IN=

# Build identity (used by app.config.ts).
IOS_BUNDLE_ID=com.example.l8r
EAS_PROJECT_ID=
